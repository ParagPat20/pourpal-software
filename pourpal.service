[Unit]
Description=PourPal Cocktail Mixing System
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=forking
User=ppl
Group=ppl
WorkingDirectory=/home/ppl/pourpal-software
ExecStart=/home/ppl/pourpal-software/start_at_boot.sh
ExecStop=/bin/bash -c "tmux kill-session -t myapp 2>/dev/null || true"
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
Environment=DISPLAY=:0
Environment=HOME=/home/ppl

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pourpal

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=graphical.target
